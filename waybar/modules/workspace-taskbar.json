// Grouped taskbar: window icons sorted under the workspace they live on.
// Merge into ~/.config/waybar/modules.json, then in the active theme's `config` put
// "hyprland/workspaces" into modules-center in place of "wlr/taskbar".
//
// Requires Waybar >= 0.15 (PR #3868). Verified on waybar 0.15.0-2.1 + Hyprland 0.56.1.
//
// TWO NON-OBVIOUS THINGS, both of which fail silently:
//
// 1. "{windows}" in `format` is REQUIRED and is not documented in the man page. It is
//    what the source actually tests (`format.find("{windows}")`). Without it the
//    module loads, the workspace buttons style correctly, and no window icon is ever
//    added - it looks like a CSS problem and is not.
//
// 2. Clicking a *workspace label* does nothing, which is why ext/workspaces is still
//    the module on the left. Waybar hardcodes the legacy IPC string
//    `dispatch workspace <n>` for workspace buttons; Hyprland 0.56 parses every
//    dispatch payload as Lua, so it always errors with "')' expected near '<n>'".
//    There is no on-click override for workspace buttons. Only the window icons are
//    clickable here; the labels are grouping separators.
//
// "on-click-window" defaults to EMPTY - without it, clicking a window icon is a no-op.
{
  "hyprland/workspaces": {
    "format": "{name} {windows}",
    "all-outputs": true,
    "active-only": false,
    "workspace-taskbar": {
      "enable": true,
      "format": "{icon}",
      "icon-size": 22,
      // Puts an "active" class on the focused window's button. Costs a redraw per
      // focus change; negligible at this icon count.
      "update-active-window": true,
      "on-click-window": "~/.config/waybar/scripts/taskbar-window-click.sh {address} {button}",
      // Matches window class OR title.
      "ignore-list": ["Alacritty"]
    }
  }
}
